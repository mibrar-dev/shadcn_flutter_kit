{
  "id": "app",
  "name": "App",
  "category": "layout",
  "description": "App shell over WidgetsApp that installs ShadcnTheme, ComponentThemes, the overlay manager and shadcn localizations, plus the ShadcnUI default text/icon scope.",
  "tier": "component",
  "install": "flutter_shadcn add app",
  "import": "import 'package:<your_app>/ui/shadcn/components/app/app.dart';",
  "tags": ["layout", "app", "shell", "bootstrap"],
  "deps": {
    "foundation": ["constants"],
    "theme": ["density", "theme"],
    "primitives": ["localizations", "overlay", "overlay_manager_layer"],
    "components": []
  },
  "files": ["app.dart", "preview.dart"],
  "api": {
    "classes": ["ShadcnApp", "ShadcnUI"],
    "enums": [],
    "constants": []
  }
}
