{
  "id": "divider",
  "name": "Divider",
  "category": "Data Display",
  "description": "Themed rule in either orientation, optionally carrying a centred label.",
  "tier": "component",
  "install": "flutter_shadcn add divider",
  "import": "import 'package:<your_app>/ui/shadcn/components/divider/divider.dart';",
  "tags": ["display", "divider", "separator", "rule"],
  "deps": {
    "foundation": [],
    "theme": ["color_tokens", "theme", "density"],
    "primitives": [],
    "components": []
  },
  "files": [
    "divider.dart",
    "divider_style.dart",
    "divider_theme.dart",
    "preview.dart"
  ],
  "api": {
    "classes": ["Divider", "DividerTheme"],
    "enums": ["DividerLabelAlignment"],
    "constants": [
      "dividerDefaults",
      "dividerDefaultThickness",
      "dividerDefaultExtent",
      "dividerDefaultLabelStyle",
      "dividerDefaultLabelPadding",
      "dividerThemeOverrides"
    ]
  },
  "theme": {
    "class": "DividerTheme",
    "userFile": "divider_theme.dart",
    "defaults": "dividerDefaults",
    "fields": {
      "color": "ThemedColor? - border token",
      "thickness": "double? - 1 (shadcn h-px)",
      "extent": "double? - 1; cross-axis size (height when horizontal, width when vertical)",
      "indent": "double? - 0, space before the rule",
      "endIndent": "double? - 0, space after the rule",
      "labelPadding": "EdgeInsetsGeometry? - 8 horizontal",
      "labelAlignment": "DividerLabelAlignment? - center",
      "labelStyle": "TextStyle? - 12px; colour falls back to mutedForeground"
    }
  }
}
