{
  "$schema": "../../../manifests/readme_meta.schema.json",
  "schemaVersion": 1,
  "id": "page_route",
  "name": "Page Route",
  "description": "Full-screen page route with the shadcn fade-and-slide transition (ShadcnPageRoute/ShadcnPage).",
  "install": "flutter_shadcn add page_route",
  "import": "import 'package:<your_app>/ui/shadcn/navigation/page_route/page_route.dart';",
  "whenToUse": {
    "use": [
      "you need push/pop navigation with the shadcn transition."
    ],
    "avoid": [
      "you need dialogs, sheets, or drawers instead of full pages."
    ]
  },
  "examples": {
    "minimal": "Navigator.of(context).push(\n  ShadcnPageRoute(builder: (context) => const SettingsPage()),\n)"
  },
  "patterns": [],
  "api": {
    "constructors": [
      "`ShadcnPageRoute<T>`",
      "`builder` (`WidgetBuilder`, required)",
      "`maintainState`, `fullscreenDialog`, `transitionDuration`, `barrierLabel`",
      "`ShadcnPage<T>` — `Page` equivalent for declarative navigation.",
      "`ShadcnPageTransition` — fade + short vertical slide.",
      "`kDefaultPageTransitionDuration` — 300ms."
    ],
    "callbacks": []
  },
  "theming": [],
  "accessibility": [
    "Provide a `barrierLabel` when the route is used as a dialog."
  ],
  "do": [
    "Use `ShadcnPage` for declarative navigation (Router, go_router)."
  ],
  "dont": [
    "Mix with MaterialPageRoute when a consistent transition matters."
  ],
  "related": [
    "pagination"
  ],
  "registryRules": [
    "One public class per file",
    "Helpers under `_impl/`"
  ]
}
