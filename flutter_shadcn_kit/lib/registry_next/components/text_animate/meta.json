{
  "id": "text_animate",
  "name": "TextAnimate",
  "category": "display",
  "description": "Stream-aware animated text renderer for incremental updates, plus a streaming markdown tail.",
  "tier": "component",
  "install": "flutter_shadcn add text_animate",
  "import": "import 'package:<your_app>/ui/shadcn/text_animate/text_animate.dart';",
  "tags": [
    "display",
    "text",
    "animation",
    "streaming"
  ],
  "deps": {
    "foundation": [],
    "theme": [
      "color_tokens",
      "theme"
    ],
    "primitives": [
      "markdown_parser",
      "streaming_text"
    ],
    "components": [
      "markdown"
    ]
  },
  "files": [
    "text_animate.dart",
    "text_animate_style.dart",
    "text_animate_theme.dart",
    "preview.dart"
  ],
  "api": {
    "classes": [
      "TextAnimate",
      "TextAnimateMarkdown",
      "TextAnimateTheme",
      "TextAnimateTypewriter",
      "TextAnimateCursor",
      "TextAnimateEffect",
      "StreamingSnapshot",
      "StreamingMarkdownSplit",
      "StreamingSectionCache",
      "StreamingClock",
      "MarkdownStreamingExtension"
    ],
    "enums": [
      "TextAnimateEffectKind"
    ],
    "functions": [
      "splitStreamingChars",
      "splitStreamingWords",
      "sharedStreamingPrefix",
      "streamingVisibleCount",
      "streamingIsSettled",
      "streamingProgress",
      "animateStreamingBlock",
      "resolveTextAnimateParts",
      "textAnimateCursorVisible"
    ],
    "constants": [
      "textAnimateDefaults",
      "textAnimateThemeOverrides"
    ]
  },
  "theme": {
    "class": "TextAnimateTheme",
    "userFile": "text_animate_theme.dart",
    "defaults": "textAnimateDefaults",
    "fields": {
      "style": "TextStyle? - base style, merged over the ambient default",
      "typewriter": "TextAnimateTypewriter? - reveal pacing, 48 units/s",
      "effect": "TextAnimateEffect? - per-unit animation, none",
      "cursor": "TextAnimateCursor? - streaming cursor, hidden"
    }
  }
}
