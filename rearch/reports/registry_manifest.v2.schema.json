{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flutter-shadcn.github.io/registry-directory/registry/registry.schema.v2.json",
  "title": "shadcn Flutter registry manifest (schemaVersion 2)",
  "description": "One generated file, lib/registry/manifests/registry.json, describing the whole post-cutover registry: the four layers, every installable component, every installable block, the theme presets and a per-file sha256 map. Generated by tool/registry/registry_manifest_generate.dart from the tree itself; the CLI reads it instead of components.json. Paths are relative to the registry root (lib/registry). See rearch/reports/P5_CLI_PLAN.md and rearch/reports/P6-B1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registry",
    "install",
    "foundation",
    "theme",
    "primitives",
    "components",
    "blocks",
    "themes",
    "fileHashes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "registry": {
      "$ref": "#/$defs/registryInfo"
    },
    "install": {
      "$ref": "#/$defs/installInfo"
    },
    "foundation": {
      "$ref": "#/$defs/unitMap"
    },
    "theme": {
      "$ref": "#/$defs/unitMap"
    },
    "primitives": {
      "$ref": "#/$defs/primitiveMap"
    },
    "components": {
      "$ref": "#/$defs/componentMap"
    },
    "blocks": {
      "$ref": "#/$defs/blockMap"
    },
    "themes": {
      "$ref": "#/$defs/themeMap"
    },
    "fileHashes": {
      "$ref": "#/$defs/hashMap"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-]*(/[a-z0-9][a-z0-9_\\-]*)?$",
      "description": "A layer unit stem (data), a folder name (form_core) or a nested stem (icons/lucide_icons)."
    },
    "relPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./\\-]*\\.(dart|json|md)$",
      "description": "Path relative to the registry root, forward slashes, no leading ./ or /."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "idList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "pathList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relPath"
      },
      "uniqueItems": true
    },
    "registryInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "description": "Git ref or source label, e.g. refactor/rearchitecture."
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "installInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "componentsDir",
        "blocksDir",
        "layerDirs",
        "userOwnedSuffix"
      ],
      "description": "Where the CLI places the tree. Layer dirs, componentsDir and blocksDir preserve the registry depth so the relative imports inside the copied files stay valid (see P5_CLI_PLAN.md 'Install layout').",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Default project-relative install root, e.g. lib/ui/shadcn."
        },
        "componentsDir": {
          "const": "components"
        },
        "blocksDir": {
          "const": "blocks"
        },
        "layerDirs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "foundation",
            "theme",
            "primitives"
          ],
          "properties": {
            "foundation": {
              "const": "foundation"
            },
            "theme": {
              "const": "theme"
            },
            "primitives": {
              "const": "primitives"
            }
          }
        },
        "userOwnedSuffix": {
          "const": "_theme.dart"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "$ref": "#/$defs/pathList"
        },
        "packages": {
          "$ref": "#/$defs/packages"
        }
      }
    },
    "unitMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/unit"
      },
      "description": "foundation/theme units: id -> the exact files to copy for that unit."
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "$ref": "#/$defs/pathList"
        },
        "deps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primitives"
          ],
          "properties": {
            "primitives": {
              "$ref": "#/$defs/idList"
            }
          }
        },
        "packages": {
          "$ref": "#/$defs/packages"
        }
      }
    },
    "primitiveMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/primitive"
      },
      "description": "primitives: id -> files plus its primitive->primitive deps (27 edges measured; foundation/theme have none)."
    },
    "componentDeps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foundation",
        "theme",
        "primitives",
        "components"
      ],
      "description": "Exactly the component meta.json deps block (check_layers enforces it equals the real imports).",
      "properties": {
        "foundation": {
          "$ref": "#/$defs/idList"
        },
        "theme": {
          "$ref": "#/$defs/idList"
        },
        "primitives": {
          "$ref": "#/$defs/idList"
        },
        "components": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "api": {
      "type": "object",
      "description": "Public-symbol summary from meta.json api; the CLI uses it for the single-owner preflight (refuse install if a symbol would be defined twice). Keys are free-form (measured: classes, enums, constants, functions, typedefs, extensions, mixins, constructors, methods, statics, types, intents, abstractClasses, transitions, reExports, plus the providedBy*/reExportedFrom*/reusedFrom* maps).",
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/stringList"
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/stringList"
            }
          }
        ]
      }
    },
    "componentTheme": {
      "type": [
        "object",
        "null"
      ],
      "description": "meta.json theme section, kept for Studio; may be null (6 components). userFile may point at another component's file (owner); a component with no theme class has class null. Free-form keys (measured: class, owner, userFile, defaults, fields, note, notes, reason, cellFields, popupTheme, menubarTheme, row); fields/cellFields are objects of field -> description and popupTheme/menubarTheme nest another theme block, so object values are free-form (P4-Z amendment; the pre-cutover data does not fit a string-only map).",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "description",
        "entry",
        "files",
        "userOwned",
        "deps",
        "tags",
        "api"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "$ref": "#/$defs/componentCategory"
        },
        "description": {
          "type": "string"
        },
        "entry": {
          "$ref": "#/$defs/relPath",
          "description": "components/<id>/<id>.dart"
        },
        "files": {
          "$ref": "#/$defs/pathList",
          "description": "Registry-owned files, excluding preview.dart and userOwned."
        },
        "userOwned": {
          "$ref": "#/$defs/pathList",
          "description": "components/<id>/<id>_theme.dart when present; never overwritten by update."
        },
        "deps": {
          "$ref": "#/$defs/componentDeps"
        },
        "tags": {
          "$ref": "#/$defs/stringList"
        },
        "listed": {
          "type": "boolean",
          "description": "Whether the docs site lists the component in its sidebar, index and command palette. Absent or true = a user-facing component; false = a building block (its preview stays for maintainers, its API stays reachable from the components that depend on it)."
        },
        "api": {
          "$ref": "#/$defs/api"
        },
        "theme": {
          "$ref": "#/$defs/componentTheme"
        },
        "install": {
          "type": "string"
        },
        "import": {
          "type": "string"
        },
        "packages": {
          "$ref": "#/$defs/packages"
        }
      }
    },
    "componentCategory": {
      "type": "string",
      "enum": [
        "Forms & Inputs",
        "Buttons & Actions",
        "Overlays",
        "Menus",
        "Navigation",
        "Data Display",
        "Feedback",
        "Layout",
        "Typography & Media",
        "Date & Time",
        "Color",
        "Animation & Effects",
        "Utilities (building blocks)"
      ],
      "description": "P6-B1 component taxonomy; gen_registry_manifest --check and check_layers enforce it."
    },
    "blockCategory": {
      "type": "string",
      "enum": [
        "Dashboard",
        "Sidebar",
        "Authentication",
        "Calendar & Scheduling",
        "Settings & Account",
        "Marketing"
      ],
      "description": "P6-B1 block taxonomy: a block is a whole page, so it is grouped by what the visitor looks for rather than by widget family."
    },
    "componentCategoryList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/componentCategory"
      },
      "uniqueItems": true
    },
    "blockCategoryList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blockCategory"
      },
      "uniqueItems": true
    },
    "componentMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/component"
      },
      "description": "id (== directory name) -> component. 118 entries post-cutover."
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "description",
        "viewport",
        "entry",
        "files",
        "docs",
        "deps",
        "tags",
        "install",
        "import"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "$ref": "#/$defs/blockCategory"
        },
        "description": {
          "type": "string"
        },
        "viewport": {
          "enum": [
            "desktop",
            "mobile"
          ],
          "description": "Layout hint for the docs stage: the block was designed at 1440 (desktop) or 375 (mobile). Both still render at every width."
        },
        "entry": {
          "$ref": "#/$defs/relPath",
          "description": "blocks/<id>/<id_underscored>.dart - the public widget, which is also the preview."
        },
        "files": {
          "$ref": "#/$defs/pathList",
          "description": "Registry-owned installable Dart files of the block."
        },
        "docs": {
          "$ref": "#/$defs/pathList",
          "description": "Documentation files of the block, hashed but never installed."
        },
        "deps": {
          "$ref": "#/$defs/blockDeps"
        },
        "tags": {
          "$ref": "#/$defs/stringList"
        },
        "install": {
          "type": "string"
        },
        "import": {
          "type": "string"
        },
        "packages": {
          "$ref": "#/$defs/packages"
        }
      }
    },
    "blockDeps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foundation",
        "theme",
        "primitives",
        "components"
      ],
      "description": "Exactly the block meta.json deps block; a block may import foundation/theme/primitives/components only, never another block (check_layers block-imports).",
      "properties": {
        "foundation": {
          "$ref": "#/$defs/idList"
        },
        "theme": {
          "$ref": "#/$defs/idList"
        },
        "primitives": {
          "$ref": "#/$defs/idList"
        },
        "components": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "blockMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/block"
      },
      "description": "id (== directory name) -> block. 16 entries at P6-B1."
    },
    "themePreset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "name",
        "modes"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/relPath",
          "description": "themes/<id>.json"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "modes": {
          "type": "array",
          "items": {
            "enum": [
              "light",
              "dark"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "themeMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/themePreset"
      },
      "description": "Preset id -> canonical schemaVersion 2 preset file. 42 entries."
    },
    "hashMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      },
      "description": "Every copyable file in the manifest, keyed by relPath, hashed with sha256 (lowercase hex). Used by update/diff; user-owned files are listed so drift can be reported but are never rewritten."
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "sdk": {
            "type": "boolean"
          },
          "constraint": {
            "type": "string"
          }
        }
      }
    }
  }
}
